# Env example for Solana Agent Desk

# Panta API Sidetrack
PANTA_API_KEY=
SOLANA_FORCE_LIVE=1

# RPC Fast Infrastructure Sidetrack
# RPCFAST_API_KEY=
# SOLANA_RPC_PROVIDER=rpcfast

# Solami Earn sidetrack
# SOLAMI_API_KEY=
# SOLANA_RPC_PROVIDER=solami

# Optional full URL override
# SOLANA_RPC_URL=https://solana-rpc.rpcfast.com/?api_key=your_key
